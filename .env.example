PORT=5000
DATABASE_URL=postgresql://erp_app:CHANGE_ME@localhost:5432/emergency_platform
CLIENT_ORIGIN=http://localhost:5173
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000

# Must be a random string of 32+ characters (see README for how to generate one)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
SESSION_HOURS=8

# Demo account passwords used only by "npm run db:setup" (choose your own, 10+ chars)
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEMO_RESPONDER_PASSWORD=CHANGE_ME_RESPONDER_PASSWORD